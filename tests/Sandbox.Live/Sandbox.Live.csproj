<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Живой стенд. Это консольная программа, а не набор xUnit: запускается только внутри Windows Sandbox
    (см. tools/sandbox/README.md) и вне Sandbox сразу выходит с кодом 3. В `dotnet test` не участвует.
    Файл AgentComposition.cs берётся из проекта агента исходником, чтобы не ссылаться на exe-проект
    (стенд публикуется как self-contained, а агент собирается отдельно и лежит в релизе).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Sandbox.Live</RootNamespace>
    <AssemblyName>Sandbox.Live</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Chistovik.Core\Chistovik.Core.csproj" />
    <ProjectReference Include="..\..\src\Chistovik.Native\Chistovik.Native.csproj" />
    <ProjectReference Include="..\..\src\Chistovik.Catalog\Chistovik.Catalog.csproj" />
    <Compile Include="..\..\src\Chistovik.Agent\AgentComposition.cs" Link="Agent\AgentComposition.cs" />
  </ItemGroup>
</Project>
