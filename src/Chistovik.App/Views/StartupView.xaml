<UserControl x:Class="Chistovik.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StartupItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
        <Style x:Key="RiskPill" TargetType="Border" BasedOn="{StaticResource PillOk}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Risk}" Value="Review">
                    <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risk}" Value="Suspicious">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,20"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding RiskSummary}" Foreground="{DynamicResource WarnBrush}"
                       FontWeight="Medium" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource StartupItem}"
                     AutomationProperties.Name="Список автозагрузки">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="62" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Command}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                           ToolTip="{Binding Command}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Publisher}" Style="{StaticResource Subtle}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ImpactText}" Style="{StaticResource MonoText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                            <Border Grid.Column="3" Style="{StaticResource RiskPill}" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RiskText}"/>
                            </Border>
                            <CheckBox Grid.Column="4" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Запускать при входе: {0}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
