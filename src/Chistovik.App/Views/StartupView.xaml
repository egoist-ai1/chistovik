<UserControl x:Class="Chistovik.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views"
             xmlns:ctl="clr-namespace:Chistovik.App.Controls">
    <UserControl.Resources>
        <Style x:Key="StartupItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <views:PageBanner Grid.Row="1"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,12" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,4">
<TextBox Style="{StaticResource SearchBox}" Width="320" Margin="0,0,12,8" Tag="Поиск по имени или команде"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Поиск в автозагрузке"/>
<WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              DisplayMemberPath="Label" MinWidth="170" Margin="0,0,8,0" VerticalAlignment="Center"
                              AutomationProperties.Name="Сортировка автозагрузки"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Все" Margin="0,0,8,0"
                            Command="{Binding FilterCommand}" CommandParameter="all"
                            AutomationProperties.Name="Показать все записи"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Можно менять" Margin="0,0,8,0"
                            Command="{Binding FilterCommand}" CommandParameter="mod"
                            AutomationProperties.Name="Показать только те, что можно менять"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Только чтение"
                            Command="{Binding FilterCommand}" CommandParameter="ro"
                            AutomationProperties.Name="Показать только для чтения"/>
                </WrapPanel>
</WrapPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="4,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource StartupItem}"
                     PreviewKeyDown="List_PreviewKeyDown"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Список автозагрузки">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="62" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Настоящий значок программы из команды запуска; нет значка: прежний общий -->
                                <ctl:AppIconTile Slot="{Binding AppIcon}" Glyph="login" Width="34" Height="34" CornerRadius="10"
                                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                                 Background="{DynamicResource Surface2Brush}"
                                                 GlyphBrush="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Command}" Style="{StaticResource MonoText}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Origin}" Style="{StaticResource Subtle}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChange}" ToolTip="{Binding ToggleHint}" ToolTipService.ShowOnDisabled="True"
                                      HorizontalAlignment="Right"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Запускать при входе: {0}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
