<UserControl x:Class="Chistovik.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <UserControl.Resources>
        <Style x:Key="StartupItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <views:PageBanner Grid.Row="1"/>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"
                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                     ItemContainerStyle="{StaticResource StartupItem}"
                     AutomationProperties.Name="Список автозагрузки">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="62" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Command}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Origin}" Style="{StaticResource Subtle}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <CheckBox Grid.Column="2" Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChange}" ToolTip="{Binding ToggleHint}"
                                      HorizontalAlignment="Right"
                                      AutomationProperties.Name="{Binding Name, StringFormat=Запускать при входе: {0}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
