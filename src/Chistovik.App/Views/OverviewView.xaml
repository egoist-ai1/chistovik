<UserControl x:Class="Chistovik.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{DynamicResource PageMargin}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,24"/>
            <views:PageBanner/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18"
                    BorderBrush="{DynamicResource AccentLineBrush}"
                    Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Добро пожаловать">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Добро пожаловать в Чистовик" Style="{StaticResource PageTitle}"
                                   FontSize="{DynamicResource FsLg}" TextWrapping="Wrap"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Чистовик помогает навести порядок в Windows: автозагрузка, службы, задачи планировщика, питание и проверенные настройки."/>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="•  Пока вы ничего не нажали, в системе ничего не меняется: экраны только показывают данные."/>
                            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="•  Перед каждым изменением вы видите, что именно изменится и как это вернуть."/>
                            <TextBlock Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="•  Каждое изменение записывается в журнал. Вернуть его можно кнопкой «Откатить» сразу после действия или позже на экране «Журнал и откат»."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Подсказка о горячих клавишах: значок клавиатуры в строке состояния внизу окна."/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Понятно"
                            VerticalAlignment="Top" Margin="24,0,0,0" Command="{Binding DismissWelcomeCommand}"
                            AutomationProperties.Name="Закрыть приветствие"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,16" AutomationProperties.Name="Права">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RightsTitle}" FontFamily="{DynamicResource FontDisplay}"
                               FontWeight="ExtraBold" FontSize="{DynamicResource FsBase}"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding RightsText}" Style="{StaticResource Subtle}"
                               Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Запросить права"
                            Command="{Binding RequestRightsCommand}" Margin="16,0,0,0" MinHeight="32" Padding="14,5"
                            Visibility="{Binding ViewOnly, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Запросить права администратора снова"/>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource Card}" AutomationProperties.Name="Автозагрузка">
                    <StackPanel>
                        <TextBlock Text="Автозагрузка" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding StartupText}" Style="{StaticResource BigNumber}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StartupHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" AutomationProperties.Name="Службы">
                    <StackPanel>
                        <TextBlock Text="Службы" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding ServicesText}" Style="{StaticResource BigNumber}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ServicesHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Grid.Row="0" Style="{StaticResource Card}" AutomationProperties.Name="Задачи планировщика">
                    <StackPanel>
                        <TextBlock Text="Задачи планировщика" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding TasksText}" Style="{StaticResource BigNumber}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TasksHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource Card}" AutomationProperties.Name="Твики">
                    <StackPanel>
                        <TextBlock Text="Твики" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding TweaksText}" Style="{StaticResource BigNumber}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding TweaksHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource Card}" AutomationProperties.Name="Режим">
                    <StackPanel>
                        <TextBlock Text="Режим" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding ModeText}" Style="{StaticResource BigNumber}" FontSize="26" Margin="0,16,0,6" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Grid.Row="2" Style="{StaticResource Card}" AutomationProperties.Name="Операции">
                    <StackPanel>
                        <TextBlock Text="Операции" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="{Binding JournalText}" Style="{StaticResource BigNumber}" Margin="0,8,0,4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding JournalHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" AutomationProperties.Name="Последние операции">
                <StackPanel>
                    <TextBlock Text="Последние операции" Style="{StaticResource CardLabel}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding RecentEmptyText}" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                               Visibility="{Binding HasRecent, Converter={StaticResource InvBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding RecentOperations}" Focusable="False"
                                  Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Subtle}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16" AutomationProperties.Name="Что учесть">
                <StackPanel>
                    <TextBlock Text="Что учесть" Style="{StaticResource CardLabel}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                             Margin="0,7,12,0" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
