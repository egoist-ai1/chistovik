<UserControl x:Class="Chistovik.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Chistovik.App.Controls"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <UserControl.Resources>
        <Style x:Key="CleanupRow" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>

        <!-- Подпись пункта фильтра в выпадающем списке: только название, без «, выбрано» из ToString -->
        <DataTemplate x:Key="ChipLabel">
            <TextBlock Text="{Binding Label}"/>
        </DataTemplate>

        <!-- Подпись блока в подробностях: моноширинная, прописными -->
        <Style x:Key="BlockLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style x:Key="BlockText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <views:PageBanner Grid.Row="1"/>

        <!-- Фильтры: поиск, область, совет -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <!-- Поиск, область и совет в одну строку; на узком окне строка переносится -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="130" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SearchBox}" Margin="0,0,10,0" Tag="Поиск по названию или описанию"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Поиск в списке чистки"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AreaChips}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                          ItemTemplate="{StaticResource ChipLabel}" MinWidth="130" Margin="0,0,10,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Фильтр по области"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding VerdictChips}" SelectedItem="{Binding SelectedVerdict, Mode=TwoWay}"
                          ItemTemplate="{StaticResource ChipLabel}" MinWidth="150" Margin="0,0,10,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Фильтр по совету"/>
                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Сканировать"
                        Command="{Binding ReloadCommand}" ToolTip="Сканировать систему заново"
                        AutomationProperties.Name="Сканировать систему заново"/>
            </Grid>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="2,0,0,0"/>
        </StackPanel>

        <!-- Список слева, подробности справа -->
        <Grid Grid.Row="3" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="230"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="3*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CleanupRow}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewKeyDown="List_PreviewKeyDown"
                             ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Once"
                             AutomationProperties.Name="Список объектов">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="58" Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Флажок есть только у строк, которые можно очистить или убрать; у остальных место пустое -->
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding CheckName}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanSelect}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Background="{Binding VerdictHue, Converter={StaticResource Hue}, ConverterParameter=Tint}">
                                        <ctl:Icon Kind="{Binding VerdictIcon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Foreground="{Binding VerdictHue, Converter={StaticResource Hue}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource Subtle}" FontSize="{DynamicResource FsXs}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding AreaText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding VerdictText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Ничего не подошло под поиск и фильтры. Сбросьте фильтр «Всё» или очистите поиск."
                               Style="{StaticResource Subtle}" Margin="20" VerticalAlignment="Top"
                               Visibility="{Binding NothingMatches, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" AutomationProperties.Name="Подробности объекта">
                <Grid>
                    <TextBlock Text="Выберите объект слева, чтобы прочитать, что это и что будет, если его убрать."
                               Style="{StaticResource Subtle}" Margin="24" VerticalAlignment="Top"
                               Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="24,22,24,24" DataContext="{Binding Selected}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,16,0" VerticalAlignment="Top"
                                        Background="{Binding VerdictHue, Converter={StaticResource Hue}, ConverterParameter=Tint}">
                                    <ctl:Icon Kind="{Binding VerdictIcon}" Size="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{Binding VerdictHue, Converter={StaticResource Hue}}"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" FontSize="{DynamicResource FsLg}"
                                               AutomationProperties.HeadingLevel="Level2"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoText}" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                               TextWrapping="Wrap" TextTrimming="None"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Border CornerRadius="11" Padding="10,4" BorderThickness="1" Margin="0,0,10,6"
                                                Background="{Binding VerdictHue, Converter={StaticResource Hue}, ConverterParameter=Tint}"
                                                BorderBrush="{Binding VerdictHue, Converter={StaticResource Hue}, ConverterParameter=Line}">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:Icon Kind="{Binding VerdictIcon}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                          Foreground="{Binding VerdictHue, Converter={StaticResource Hue}}"/>
                                                <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" FontSize="{DynamicResource FsXs}"
                                                           Foreground="{Binding VerdictHue, Converter={StaticResource Hue}}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,10,6"><TextBlock Text="{Binding AreaText}"/></Border>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,10,6"><TextBlock Text="{Binding RiskText}"/></Border>
                                        <Border Style="{StaticResource Pill}" Margin="0,0,10,6"
                                                Visibility="{Binding HasReversibleText, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ReversiblePill}"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ЧТО ЭТО" Style="{StaticResource BlockLabel}"/>
                            <TextBlock Text="{Binding WhatIsIt}" Style="{StaticResource BlockText}"/>
                            <TextBlock Text="ЗАЧЕМ НУЖНО" Style="{StaticResource BlockLabel}"/>
                            <TextBlock Text="{Binding WhyNeeded}" Style="{StaticResource BlockText}"/>
                            <TextBlock Text="ЧТО БУДЕТ, ЕСЛИ УБРАТЬ" Style="{StaticResource BlockLabel}"/>
                            <TextBlock Text="{Binding IfRemoved}" Style="{StaticResource BlockText}"/>
                            <TextBlock Text="КАК ВЕРНУТЬ" Style="{StaticResource BlockLabel}"/>
                            <TextBlock Text="{Binding HowToUndo}" Style="{StaticResource BlockText}"/>
                            <TextBlock Text="{Binding ReversibilityText}" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>

                            <TextBlock Text="ПОЧЕМУ ТАКОЙ СОВЕТ" Style="{StaticResource BlockLabel}"/>
                            <ItemsControl ItemsSource="{Binding Reasons}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource BlockText}" LineHeight="20"/>
                                                <TextBlock Text="{Binding Evidence}" Style="{StaticResource MonoText}"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                                           TextWrapping="Wrap" TextTrimming="None"
                                                           Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ConfidenceText, StringFormat=Уверенность: {0}}" Style="{StaticResource Subtle}"
                                       Margin="0,4,0,0"/>

                            <Border Margin="0,22,0,0" Padding="14,12" CornerRadius="{DynamicResource RadiusMd}"
                                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctl:Icon Kind="eye" Size="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ClassText}" Style="{StaticResource Subtle}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding OpenText}"
                                            Command="{Binding OpenCommand}" Margin="16,0,0,0" MinHeight="32" Padding="14,5"
                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="Открыть раздел, где этот объект можно менять"/>
                                </Grid>
                            </Border>

                            <!-- Удаление программы: кнопка видна только там, где политика агента разрешает; подтверждение и итог на странице -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource DangerButton}" Content="Удалить программу" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AutomationProperties.Name="Удалить выбранную программу через агента"/>
                                <TextBlock Text="Вернуть программу откатом из журнала нельзя: только установкой заново."
                                           Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Под списком: ход работы агента и панель действий (появляется, когда отмечены категории диска или записи реестра) -->
        <StackPanel Grid.Row="4" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Идёт работа агента" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal">
                    <ctl:Icon Kind="refresh" Size="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0"
                    Visibility="{Binding HasChecked, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Выбранное для очистки">
                <WrapPanel>
                    <WrapPanel Visibility="{Binding HasCheckedDisk, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">
                        <ctl:Icon Kind="drive" Size="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DiskSelectionText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource DangerButton}" Content="Очистить выбранные категории" MinHeight="32" Padding="14,5"
                                Command="{Binding CleanDiskCommand}" ToolTip="Вернуть удалённое нельзя"
                                AutomationProperties.Name="Очистить выбранные категории"/>
                    </WrapPanel>
                    <WrapPanel Visibility="{Binding HasCheckedRegistry, Converter={StaticResource BoolToVis}}" Margin="0,0,16,0">
                        <ctl:Icon Kind="database" Size="18" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RegistrySelectionText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Удалить выбранные записи реестра" MinHeight="32" Padding="14,5"
                                Command="{Binding ApplyRegistryCommand}" ToolTip="Копия на 90 дней, откат из журнала"
                                AutomationProperties.Name="Удалить выбранные записи реестра"/>
                    </WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Снять выбор" Command="{Binding ClearSelectionCommand}"
                            AutomationProperties.Name="Снять выбор со всех строк"/>
                    <TextBlock Text="{Binding ActionHint}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
