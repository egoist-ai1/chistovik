<UserControl x:Class="Chistovik.App.Views.ModesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <Grid Margin="{DynamicResource PageMargin}">
        <!-- Вся страница, шапка тоже, прокручивается одним ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}"/>
            <views:PageBanner/>
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Content="{Binding UndoLastText}" Command="{Binding UndoLastCommand}"
                    Visibility="{Binding CanUndoLast, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Откатить последний применённый режим целиком">
                <!-- Имя режима показываем TextBlock-ом: в ContentPresenter «_» читался бы как мнемоника и пропадал. -->
                <Button.ContentTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" AutomationProperties.Name="Режимы"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource FontDisplay}"
                                                   FontWeight="Bold" FontSize="{DynamicResource FsLg}"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Tag}"/>
                                        </Border>
                                        <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                Visibility="{Binding TouchesMachine, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="для всего компьютера"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextBrush}"
                                               TextWrapping="Wrap" Margin="0,6,0,8"/>
                                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TweaksText}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SchemeNote}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Применить"
                                        Command="{Binding ApplyCommand}" Margin="20,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Применить режим {0}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
