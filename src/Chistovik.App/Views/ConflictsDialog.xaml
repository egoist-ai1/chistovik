<Window x:Class="Chistovik.App.Views.ConflictsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Откат: значения изменились"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource FsBase}">
    <StackPanel Margin="28">
        <TextBlock Text="После этой операции что-то изменилось" Style="{StaticResource PageTitle}"
                   FontSize="{DynamicResource FsLg}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,16"
                   Text="Ниже значения, которые уже не такие, как их оставила операция. Включите переключатель, чтобы вернуть прежнее значение поверх текущего; выключенное останется как есть."/>
        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl x:Name="Rows" Focusable="False" AutomationProperties.Name="Конфликты отката">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Current}" Style="{StaticResource MonoText}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                                    <TextBlock Text="{Binding Cause}" Style="{StaticResource Subtle}" FontSize="{DynamicResource FsXs}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding Overwrite, Mode=TwoWay}"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{Binding Title, StringFormat=Перезаписать: {0}}"/>
                                    <TextBlock Text="{Binding ChoiceText}" Style="{StaticResource Subtle}"
                                               FontSize="{DynamicResource FsXs}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Отмена" IsCancel="True" Margin="0,0,8,0"
                    Click="OnCancel" AutomationProperties.Name="Отменить откат"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Продолжить откат" IsDefault="True" Click="OnOk"
                    AutomationProperties.Name="Продолжить откат с выбранными решениями"/>
        </StackPanel>
    </StackPanel>
</Window>
