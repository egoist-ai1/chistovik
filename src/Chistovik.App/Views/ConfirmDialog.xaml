<Window x:Class="Chistovik.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Chistovik.App.Controls"
        Width="560" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource FsBase}">
    <!-- Одно окно для опасных действий: что изменится, как вернуть, две кнопки. Esc = отмена. -->
    <Border x:Name="Root" Padding="28,26,28,24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="Badge" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentTintBrush}"
                        VerticalAlignment="Center">
                    <ctl:Icon x:Name="BadgeIcon" Kind="info" Size="20" Foreground="{DynamicResource AccentBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="KindText" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource CardLabel}"
                           Text="Подтверждение"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="{DynamicResource FsLg}"
                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Что произойдёт" Style="{StaticResource CardLabel}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="MessageText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <Border x:Name="RollbackBox" Margin="0,16,0,0" Padding="14,12" Visibility="Collapsed"
                            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ctl:Icon Kind="undo" Size="16" Foreground="{DynamicResource AccentBrush}"
                                          Margin="0,1,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Как вернуть" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="RollbackText" Style="{StaticResource Subtle}" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Отмена" IsCancel="True"
                        Margin="0,0,8,0" Click="OnCancel" AutomationProperties.Name="Отменить, ничего не менять"/>
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
