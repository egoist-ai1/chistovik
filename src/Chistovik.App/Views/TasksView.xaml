<UserControl x:Class="Chistovik.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <UserControl.Resources>
        <Style x:Key="TaskItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
        <Style x:Key="ClassPill" TargetType="Border" BasedOn="{StaticResource PillOk}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Class}" Value="ReadOnly">
                    <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Class}" Value="Forbidden">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*" MinWidth="260" MaxWidth="380"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <views:PageBanner Grid.Row="1" Grid.ColumnSpan="3"/>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,4"
              Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
<TextBox Style="{StaticResource SearchBox}" Width="320" Margin="0,0,12,8" Tag="Поиск по имени или пути"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Поиск задач"/>
<WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                          DisplayMemberPath="Label" MinWidth="170" Margin="0,0,8,0" VerticalAlignment="Center"
                          AutomationProperties.Name="Сортировка списка задач"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Все" Margin="0,0,8,0"
                        Command="{Binding FilterCommand}" CommandParameter="all"
                        AutomationProperties.Name="Показать все задачи"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Можно менять" Margin="0,0,8,0"
                        Command="{Binding FilterCommand}" CommandParameter="mod"
                        AutomationProperties.Name="Показать только те, что можно менять"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Только чтение"
                        Command="{Binding FilterCommand}" CommandParameter="ro"
                        AutomationProperties.Name="Показать только для чтения"/>
            </WrapPanel>
</WrapPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource TaskItem}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Once"
                     AutomationProperties.Name="Список задач">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="56" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Style="{StaticResource ClassPill}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ClassText}"/>
                                </Border>
                                <TextBlock Text="{Binding EnabledText}" Style="{StaticResource Subtle}"
                                           FontSize="{DynamicResource FsXs}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Padding="24"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Выберите задачу слева" Style="{StaticResource Subtle}"
                           Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"/>
                <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold"
                               FontSize="{DynamicResource FsLg}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource MonoText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"/>
                    <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="Что запускает" Style="{StaticResource CardLabel}" Margin="0,16,0,4"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource MonoText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                </StackPanel>
                <TextBlock Text="{Binding DetailHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0"
                            ToolTip="{Binding ApplyTooltip}" ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SecondaryButton}" Content="Включить" Margin="0,0,8,0"
                            Command="{Binding SetEnabledCommand}" CommandParameter="on"
                            AutomationProperties.Name="Включить задачу"/>
                    <Button Style="{StaticResource DangerButton}" Content="Выключить"
                            Command="{Binding SetEnabledCommand}" CommandParameter="off"
                            AutomationProperties.Name="Выключить задачу"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="4,10,0,0"
                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
