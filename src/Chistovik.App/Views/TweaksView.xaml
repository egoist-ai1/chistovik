<UserControl x:Class="Chistovik.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка прокручивается вместе со списком; закреплён только ряд «Применить / Сбросить выбор» внизу -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}"/>

            <views:PageBanner/>

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.Name="Группы твиков"
                          Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardLabel}" Margin="4,0,0,8"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <Border Style="{StaticResource Card}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14"
                                                    AutomationProperties.Name="{Binding AutomationName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="Medium" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource PillWarn}" Margin="10,0,0,0"
                                                                    Visibility="{Binding IsCareful, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding RiskText}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Этот твик ещё не проверялся на живой системе и в песочнице">
                                                                <TextBlock Text="{Binding UnverifiedText}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsNotApplicable, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Для этого твика нужна другая редакция Windows: запись останется, но ничего не изменит">
                                                                <TextBlock Text="{Binding NotApplicableText}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="На этой сборке Windows твик ничего не изменит, применить его нельзя">
                                                                <TextBlock Text="{Binding UnavailableText}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                    Visibility="{Binding IsMachineWide, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding ScopeText}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource MonoText}"
                                                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                                                            <TextBlock Text="{Binding RestartText}" Style="{StaticResource MonoText}"
                                                                       Foreground="{DynamicResource WarnBrush}" FontSize="{DynamicResource FsXs}"
                                                                       Margin="12,0,0,0"
                                                                       Visibility="{Binding HasRestart, Converter={StaticResource BoolToVis}}"/>
                                                            <TextBlock Text="{Binding RevertText}" Style="{StaticResource MonoText}"
                                                                       Foreground="{DynamicResource WarnBrush}" FontSize="{DynamicResource FsXs}"
                                                                       Margin="12,0,0,0"
                                                                       Visibility="{Binding RevertsAfterUpdate, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center">
                                                        <CheckBox Style="{StaticResource SwitchToggle}"
                                                                  IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="16,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  IsEnabled="{Binding DataContext.CanApply, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  AutomationProperties.Name="{Binding Title, StringFormat=Включить: {0}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyText}"
                        Command="{Binding ApplyCommand}" Margin="0,0,8,0"
                        ToolTip="{Binding ApplyHint}"
                        AutomationProperties.Name="Применить выбранные изменения"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Сбросить выбор"
                        Command="{Binding DiscardCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="Сбросить несохранённый выбор"/>
                <!-- «Только просмотр» уже сказано баннером и строкой состояния: тут не повторяем -->
                <TextBlock Text="{Binding ApplyHint}" Style="{StaticResource Subtle}" VerticalAlignment="Center"
                           Visibility="{Binding ViewOnly, Converter={StaticResource InvBoolToVis}}"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Перезапустить Проводник"
                    Command="{Binding RestartExplorerCommand}"
                    Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Перезапустить Проводник, чтобы изменения вступили в силу"/>
        </Grid>
    </Grid>
</UserControl>
