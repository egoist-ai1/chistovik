<UserControl x:Class="Chistovik.App.Views.PowerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <views:PageBanner/>
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Схемы" Style="{StaticResource CardLabel}" Margin="4,0,0,8"
                           AutomationProperties.HeadingLevel="Level2"/>
                <ItemsControl ItemsSource="{Binding Schemes}" Focusable="False" AutomationProperties.Name="Схемы питания">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                            <Border Style="{StaticResource PillOk}" Margin="10,0,0,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="активна"/>
                                            </Border>
                                            <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                    Visibility="{Binding IsUnverified, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Идентификатор схемы ещё не сверен на реальной системе">
                                                <TextBlock Text="не проверено"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                    Visibility="{Binding CreatesCopy, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="создаст копию"/>
                                            </Border>
                                            <Border Style="{StaticResource PillWarn}" Margin="6,0,0,0"
                                                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="На этом устройстве такой схемы нет (например, на ноутбуках с Modern Standby доступна только «Сбалансированная»)">
                                                <TextBlock Text="нет на этом устройстве"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Включить"
                                            Command="{Binding ApplyCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Title, StringFormat=Включить схему {0}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Параметры активной схемы" Style="{StaticResource CardLabel}" Margin="4,16,0,8"
                           AutomationProperties.HeadingLevel="Level2"/>
                <ItemsControl ItemsSource="{Binding Settings}" Focusable="False" AutomationProperties.Name="Параметры питания">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding UnitText}" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                                        <TextBlock Text="{Binding CurrentText}" Style="{StaticResource MonoText}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="от сети" Style="{StaticResource Subtle}" FontSize="{DynamicResource FsXs}"/>
                                            <TextBox Width="76" Style="{StaticResource NumberBox}" Text="{Binding AcText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Title, StringFormat=Значение от сети: {0}}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="от батареи" Style="{StaticResource Subtle}" FontSize="{DynamicResource FsXs}"/>
                                            <TextBox Width="76" Style="{StaticResource NumberBox}" Text="{Binding DcText, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Title, StringFormat=Значение от батареи: {0}}"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Применить" Command="{Binding ApplyCommand}"
                                                VerticalAlignment="Bottom"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Применить параметр {0}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
