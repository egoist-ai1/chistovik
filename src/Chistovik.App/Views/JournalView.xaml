<UserControl x:Class="Chistovik.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OpItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Завершено">
                    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Частично">
                    <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Прервано">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="○"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter Property="Text" Value="✓"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,20"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Operations}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource OpItem}"
                     AutomationProperties.Name="Список операций">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="64" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Status}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="28">
            <Grid DataContext="{Binding Selected}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold"
                               FontSize="{DynamicResource FsLg}" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
                        <TextBlock Text="{Binding Id}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource StatusPill}"><TextBlock Text="{Binding Status}"/></Border>
                    </StackPanel>
                    <TextBlock Text="Шаги" Style="{StaticResource CardLabel}" Margin="0,0,0,10"/>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Focusable="False"
                              AutomationProperties.Name="Шаги операции">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource StepGlyph}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Row="2" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="Откатить"
                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        AutomationProperties.Name="Откатить выбранную операцию"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
