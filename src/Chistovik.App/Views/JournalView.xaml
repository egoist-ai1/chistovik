<UserControl x:Class="Chistovik.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <UserControl.Resources>
        <Style x:Key="OpItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGood}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBad}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="○"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Text" Value="✓"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                    <Setter Property="Text" Value="!"/>
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" MaxWidth="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16" TextWrapping="Wrap"/>
        </StackPanel>

        <views:PageBanner Grid.Row="1" Grid.ColumnSpan="3"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Operations}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource OpItem}"
                     AutomationProperties.Name="Список операций">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="64" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                                           FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FsXs}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Status}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="28"
                Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold"
                               FontSize="{DynamicResource FsLg}" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,8,0,20">
                        <TextBlock Text="{Binding Id}" ToolTip="{Binding DetailsTip}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource MonoText}"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource StatusPill}"><TextBlock Text="{Binding Status}"/></Border>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <TextBlock Text="Шаги" Style="{StaticResource CardLabel}" Margin="0,0,0,10"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False"
                                      AutomationProperties.Name="Шаги операции">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource StepGlyph}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Foreground="{DynamicResource TextBrush}" FontWeight="Medium" TextWrapping="Wrap">
                                                <Run Text="{Binding Title, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StateText, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding RollbackHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Content="Откатить"
                            Command="{Binding RollbackCommand}"
                            AutomationProperties.Name="Откатить выбранную операцию"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
