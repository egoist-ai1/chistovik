<UserControl x:Class="Chistovik.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="{DynamicResource PageMargin}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                   AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,24"/>
        <Border Style="{StaticResource Card}" HorizontalAlignment="Left" MaxWidth="560"
                AutomationProperties.Name="Раздел в разработке">
            <StackPanel>
                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <TextBlock Text="В разработке"/>
                </Border>
                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
