<UserControl x:Class="Chistovik.App.Views.PageBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общая полоса экрана: режим просмотра, итог действия (сводка и «Откатить»), состояние загрузки. DataContext — StatefulPageViewModel. -->
    <UserControl.Resources>
        <Style x:Key="GlyphIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource FontIcons}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Режим просмотра -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding ShowViewOnlyBanner, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Режим просмотра">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE7B3;" Foreground="{DynamicResource WarnBrush}" Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource PillWarn}" Margin="0,0,12,0"><TextBlock Text="Просмотр"/></Border>
                    <TextBlock Text="{Binding ViewOnlyText}" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Запросить права"
                        Command="{Binding RequestRightsCommand}" Margin="16,0,0,0"
                        AutomationProperties.Name="Запросить права администратора снова"/>
            </Grid>
        </Border>

        <!-- Итог действия -->
        <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="{DynamicResource RadiusLg}" BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Итог действия" AutomationProperties.LiveSetting="Polite">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentLineBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultIsWarn}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource WarnLineBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultIsBad}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultGlyph}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultIsWarn}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ResultIsBad}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultCounts}" Style="{StaticResource MonoText}" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextBrush}" TextTrimming="None" TextWrapping="Wrap"
                               Visibility="{Binding HasResultCounts, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding ResultProblems}" Margin="0,6,0,0" Focusable="False"
                                  Visibility="{Binding HasResultProblems, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{DynamicResource TextBrush}"
                                               FontSize="{DynamicResource FsSm}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextBrush}"
                               Visibility="{Binding HasResultHint, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="Откатить"
                            Command="{Binding UndoResultCommand}" Margin="0,0,4,0"
                            Visibility="{Binding CanUndoResult, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Откатить только что выполненное изменение"/>
                    <Button Style="{StaticResource GhostButton}" Content="Журнал"
                            Command="{Binding OpenJournalCommand}"
                            Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Открыть журнал и откат"/>
                    <Button Style="{StaticResource GhostButton}" Content="Скрыть"
                            Command="{Binding DismissResultCommand}"
                            AutomationProperties.Name="Скрыть итог действия"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Состояние раздела: загрузка, пусто, ошибка -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding ShowStateLine, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Состояние раздела">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="Text" Value="&#xE895;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Text" Value="&#xE783;"/>
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter Property="Text" Value="&#xE946;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding StateMessage}" TextWrapping="Wrap" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Повторить"
                            Command="{Binding ReloadCommand}" Margin="16,0,0,0"
                            Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Повторить загрузку"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Отменить"
                            Command="{Binding CancelLoadCommand}" Margin="16,0,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Отменить загрузку"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Обновить"
                            Command="{Binding ReloadCommand}" Margin="16,0,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Обновить список"/>
                </Grid>
                <!-- Скелетон: форма будущего списка, пока данные читаются -->
                <StackPanel Margin="0,18,0,6" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
>
                    <Grid Margin="0,0,0,18"><Border Style="{StaticResource SkeletonBar}" Width="300"/><Border Style="{StaticResource SkeletonBar}" Width="110" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,18"><Border Style="{StaticResource SkeletonBar}" Width="240"/><Border Style="{StaticResource SkeletonBar}" Width="110" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,18"><Border Style="{StaticResource SkeletonBar}" Width="360"/><Border Style="{StaticResource SkeletonBar}" Width="110" HorizontalAlignment="Right"/></Grid>
                    <Grid><Border Style="{StaticResource SkeletonBar}" Width="200"/><Border Style="{StaticResource SkeletonBar}" Width="110" HorizontalAlignment="Right"/></Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
