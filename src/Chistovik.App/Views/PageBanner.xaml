<UserControl x:Class="Chistovik.App.Views.PageBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общая полоса экрана: режим просмотра, итог действия, состояние загрузки. DataContext — StatefulPageViewModel. -->
    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding ViewOnly, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Режим просмотра">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource PillWarn}" Margin="0,0,12,0"><TextBlock Text="Просмотр"/></Border>
                    <TextBlock Text="{Binding ViewOnlyText}" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Запросить права"
                        Command="{Binding RequestRightsCommand}" Margin="16,0,0,0"
                        AutomationProperties.Name="Запросить права администратора снова"/>
            </Grid>
        </Border>

        <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="{DynamicResource RadiusLg}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Итог действия">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsGood}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultIsWarn}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ResultIsBad}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ResultText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultHint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasResultHint, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Открыть журнал"
                        Command="{Binding OpenJournalCommand}" Margin="16,0,0,0"
                        Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Открыть журнал и откат"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding ShowStateLine, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Состояние раздела">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StateMessage}" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Повторить"
                        Command="{Binding ReloadCommand}" Margin="16,0,0,0"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Повторить загрузку"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Отменить"
                        Command="{Binding CancelLoadCommand}" Margin="16,0,0,0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Отменить загрузку"/>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Обновить"
                        Command="{Binding ReloadCommand}" Margin="16,0,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Обновить список"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
