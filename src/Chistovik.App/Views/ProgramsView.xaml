<UserControl x:Class="Chistovik.App.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Chistovik.App.Views">
    <UserControl.Resources>
        <Style x:Key="ProgramItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" Margin="0,6,0,16"/>
            <views:PageBanner/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Tag="Поиск по названию или издателю"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Поиск программ"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Style="{StaticResource Subtle}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="Снять выбор"
                        Command="{Binding ClearSelectionCommand}" Margin="0,0,8,0"
                        AutomationProperties.Name="Снять выбор со всех программ"/>
                <Button Style="{StaticResource DangerButton}" Content="Удалить"
                        Command="{Binding DeleteCommand}"
                        AutomationProperties.Name="Удалить выбранные программы"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовки колонок -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="Все" Command="{Binding SelectAllCommand}"
                                HorizontalAlignment="Left" AutomationProperties.Name="Выбрать все показанные программы"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Command="{Binding SortCommand}" CommandParameter="Name"
                                Content="{Binding NameHeader}"
                                AutomationProperties.Name="Сортировать по названию"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                Command="{Binding SortCommand}" CommandParameter="Publisher"
                                Content="{Binding PublisherHeader}"
                                AutomationProperties.Name="Сортировать по издателю"/>
                        <TextBlock Grid.Column="3" Text="Версия" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="4" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding SortCommand}" CommandParameter="Size"
                                Content="{Binding SizeHeader}"
                                AutomationProperties.Name="Сортировать по размеру"/>
                        <Button Grid.Column="5" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding SortCommand}" CommandParameter="Date"
                                Content="{Binding DateHeader}"
                                AutomationProperties.Name="Сортировать по дате установки"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource ProgramItem}"
                         AutomationProperties.Name="Список установленных программ">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="52" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding AutomationName}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextBrush}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Subtle}"
                                               FontSize="{DynamicResource FsXs}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Publisher}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource MonoText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding DateText}" Style="{StaticResource MonoText}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource Subtle}" Margin="4,10,0,0"/>
    </Grid>
</UserControl>
