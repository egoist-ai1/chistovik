<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Egoist DS, режим Signal, тёмная тема -->
    <Color x:Key="BgColor">#0E0E0F</Color>
    <Color x:Key="SurfaceColor">#141416</Color>
    <Color x:Key="Surface2Color">#1C1C1E</Color>
    <Color x:Key="Surface3Color">#26262A</Color>
    <Color x:Key="BorderColor">#2E2E32</Color>
    <Color x:Key="TextColor">#F2F2EE</Color>
    <Color x:Key="TextMutedColor">#A3A3AA</Color>
    <Color x:Key="AccentColor">#D7FF3C</Color>
    <Color x:Key="AccentHoverColor">#E4FF7A</Color>
    <Color x:Key="OnAccentColor">#0E0E0F</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="WarnColor">#FFC247</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#26D7FF3C"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#26FF6B6B"/>
    <SolidColorBrush x:Key="WarnTintBrush" Color="#26FFC247"/>

    <!-- Граница полей ввода: 3,2:1 к поверхности (WCAG 1.4.11); обычная BorderBrush только разделяет -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#6B6B73"/>
    <SolidColorBrush x:Key="SkeletonBrush" Color="#26262A"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#66D7FF3C"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#66FFC247"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#66FF6B6B"/>

    <!--
        Цвета разделов. Лайм остаётся главным акцентом (действия, фокус, активное), остальные оттенки различают
        разделы и группы находок: значок, пилюля, полоса сверху карточки. Все на тёмной поверхности держат контраст не ниже 4,5:1.
        Для каждого оттенка три кисти: Hue<Имя>Brush (линия и текст), Hue<Имя>TintBrush (заливка 15 %), Hue<Имя>LineBrush (рамка 40 %).
        Имена используются конвертером HueConverter по ключу из NavItem.Hue.
    -->
    <SolidColorBrush x:Key="HueLimeBrush" Color="#D7FF3C"/>
    <SolidColorBrush x:Key="HueLimeTintBrush" Color="#26D7FF3C"/>
    <SolidColorBrush x:Key="HueLimeLineBrush" Color="#66D7FF3C"/>
    <SolidColorBrush x:Key="HueBlueBrush" Color="#6EA8FF"/>
    <SolidColorBrush x:Key="HueBlueTintBrush" Color="#266EA8FF"/>
    <SolidColorBrush x:Key="HueBlueLineBrush" Color="#666EA8FF"/>
    <SolidColorBrush x:Key="HueOrangeBrush" Color="#FF9F5A"/>
    <SolidColorBrush x:Key="HueOrangeTintBrush" Color="#26FF9F5A"/>
    <SolidColorBrush x:Key="HueOrangeLineBrush" Color="#66FF9F5A"/>
    <SolidColorBrush x:Key="HueCyanBrush" Color="#4FD8FF"/>
    <SolidColorBrush x:Key="HueCyanTintBrush" Color="#264FD8FF"/>
    <SolidColorBrush x:Key="HueCyanLineBrush" Color="#664FD8FF"/>
    <SolidColorBrush x:Key="HueVioletBrush" Color="#B79CFF"/>
    <SolidColorBrush x:Key="HueVioletTintBrush" Color="#26B79CFF"/>
    <SolidColorBrush x:Key="HueVioletLineBrush" Color="#66B79CFF"/>
    <SolidColorBrush x:Key="HueMintBrush" Color="#5CF2B5"/>
    <SolidColorBrush x:Key="HueMintTintBrush" Color="#265CF2B5"/>
    <SolidColorBrush x:Key="HueMintLineBrush" Color="#665CF2B5"/>
    <SolidColorBrush x:Key="HuePinkBrush" Color="#FF7ADB"/>
    <SolidColorBrush x:Key="HuePinkTintBrush" Color="#26FF7ADB"/>
    <SolidColorBrush x:Key="HuePinkLineBrush" Color="#66FF7ADB"/>
    <SolidColorBrush x:Key="HueSlateBrush" Color="#C8CCD8"/>
    <SolidColorBrush x:Key="HueSlateTintBrush" Color="#26C8CCD8"/>
    <SolidColorBrush x:Key="HueSlateLineBrush" Color="#66C8CCD8"/>

    <!-- Подсветка под курсором и тонкая светлая кромка карточек -->
    <SolidColorBrush x:Key="HoverVeilBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="EdgeLightBrush" Color="#14FFFFFF"/>

    <!-- Радиусы -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Отступы -->
    <Thickness x:Key="PadSm">8</Thickness>
    <Thickness x:Key="PadMd">16</Thickness>
    <Thickness x:Key="PadLg">24</Thickness>
    <Thickness x:Key="PageMargin">32,28,32,24</Thickness>

    <!--
        Плотность. MainWindow.xaml.cs подменяет эти значения в ресурсах окна, когда область содержимого ниже 620 DIP
        («компактно»): тогда заголовок меньше, подзаголовок в одну строку, меню плотнее. Здесь — обычные значения.
    -->
    <sys:Boolean x:Key="CompactMode">False</sys:Boolean>
    <sys:Double x:Key="FsPageTitle">28</sys:Double>
    <Thickness x:Key="SubtitleMargin">0,6,0,16</Thickness>
    <TextWrapping x:Key="SubtitleWrap">Wrap</TextWrapping>
    <TextTrimming x:Key="SubtitleTrim">None</TextTrimming>
    <Thickness x:Key="NavRowPadding">10,6,14,6</Thickness>
    <Thickness x:Key="NavGroupMargin">22,18,0,6</Thickness>
    <Thickness x:Key="NavLogoMargin">20,24,0,12</Thickness>
    <Thickness x:Key="NavListMargin">0,0,0,12</Thickness>

    <!-- Шрифты встроены в сборку (папка Fonts); запасной стек — на случай сбоя загрузки -->
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Fonts/#Unbounded, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontText">pack://application:,,,/Fonts/#Onest, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- Типографика: шкала с шагом около 1,25. Заголовки и числа — Unbounded, текст — Onest, цифры и пути — JetBrains Mono -->
    <sys:Double x:Key="FsXs">12</sys:Double>
    <sys:Double x:Key="FsSm">13.5</sys:Double>
    <sys:Double x:Key="FsBase">15</sys:Double>
    <sys:Double x:Key="FsMd">17</sys:Double>
    <sys:Double x:Key="FsLg">20</sys:Double>
    <sys:Double x:Key="FsXl">28</sys:Double>
    <sys:Double x:Key="FsXxl">38</sys:Double>
    <sys:Double x:Key="FsHero">56</sys:Double>

    <!-- Движение -->
    <Duration x:Key="DurFast">0:0:0.12</Duration>
    <Duration x:Key="DurBase">0:0:0.2</Duration>
    <!-- Длительности и повтор переопределяются в App при отключённых анимациях Windows (reduced motion) -->
    <Duration x:Key="DurSwitch">0:0:0.16</Duration>
    <Duration x:Key="DurSkeleton">0:0:0.9</Duration>
    <RepeatBehavior x:Key="SkeletonRepeat">Forever</RepeatBehavior>
</ResourceDictionary>
