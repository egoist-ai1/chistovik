<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Egoist DS, режим Signal, тёмная тема -->
    <Color x:Key="BgColor">#0E0E0F</Color>
    <Color x:Key="SurfaceColor">#141416</Color>
    <Color x:Key="Surface2Color">#1C1C1E</Color>
    <Color x:Key="Surface3Color">#26262A</Color>
    <Color x:Key="BorderColor">#2E2E32</Color>
    <Color x:Key="TextColor">#F2F2EE</Color>
    <Color x:Key="TextMutedColor">#A3A3AA</Color>
    <Color x:Key="AccentColor">#D7FF3C</Color>
    <Color x:Key="AccentHoverColor">#E4FF7A</Color>
    <Color x:Key="OnAccentColor">#0E0E0F</Color>
    <Color x:Key="DangerColor">#FF6B6B</Color>
    <Color x:Key="WarnColor">#FFC247</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#26D7FF3C"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#26FF6B6B"/>
    <SolidColorBrush x:Key="WarnTintBrush" Color="#26FFC247"/>

    <!-- Радиусы -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">10</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Отступы -->
    <Thickness x:Key="PadSm">8</Thickness>
    <Thickness x:Key="PadMd">16</Thickness>
    <Thickness x:Key="PadLg">24</Thickness>
    <Thickness x:Key="PageMargin">32,28,32,24</Thickness>

    <!-- Шрифты: Unbounded/Onest/JetBrains Mono, пока не встроены — запасной стек -->
    <FontFamily x:Key="FontDisplay">Unbounded, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FontText">Onest, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Типографика -->
    <sys:Double x:Key="FsXs">12</sys:Double>
    <sys:Double x:Key="FsSm">13</sys:Double>
    <sys:Double x:Key="FsBase">15</sys:Double>
    <sys:Double x:Key="FsLg">18</sys:Double>
    <sys:Double x:Key="FsXl">26</sys:Double>
    <sys:Double x:Key="FsHero">56</sys:Double>

    <!-- Движение -->
    <Duration x:Key="DurFast">0:0:0.12</Duration>
    <Duration x:Key="DurBase">0:0:0.2</Duration>
</ResourceDictionary>
