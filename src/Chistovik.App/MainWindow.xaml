<Window x:Class="Chistovik.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chistovik.App.ViewModels"
        xmlns:views="clr-namespace:Chistovik.App.Views"
        xmlns:ctl="clr-namespace:Chistovik.App.Controls"
        Title="Чистовик" Width="1320" Height="820" MinWidth="900" MinHeight="600"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource FontText}" FontSize="{DynamicResource FsBase}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" RenderOptions.ClearTypeHint="Enabled">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsViewModel}"><views:ProgramsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JournalViewModel}"><views:JournalView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TweaksViewModel}"><views:TweaksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModesViewModel}"><views:ModesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PowerViewModel}"><views:PowerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}"><views:ServicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksViewModel}"><views:TasksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource FsXs}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="22,18,0,6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding GroupStart}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavItemContainer" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        </Style>

        <DataTemplate x:Key="NavTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Group}" Style="{StaticResource GroupHeader}"/>
                <Grid>
                    <Border x:Name="Row" Margin="10,1" Padding="10,6,14,6" CornerRadius="{DynamicResource RadiusMd}"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Значок раздела в своём оттенке; у активного раздела на плашке той же тонировки -->
                            <Border x:Name="Chip" Width="30" Height="30" CornerRadius="9" Background="Transparent"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ChipScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ctl:Icon Kind="{Binding Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{Binding Hue, Converter={StaticResource Hue}}"/>
                            </Border>
                            <TextBlock x:Name="Label" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Полоска слева: активный раздел виден формой, а не только цветом; выезжает по высоте -->
                    <Rectangle x:Name="Bar" Width="4" Height="22" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                               Margin="10,0,0,0" Fill="{Binding Hue, Converter={StaticResource Hue}}"
                               RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="BarScale" ScaleX="1" ScaleY="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="{StaticResource DurFast}"/>
                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="{StaticResource DurFast}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource DurBase}"/>
                                <DoubleAnimation Storyboard.TargetName="ChipScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurBase}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{Binding Hue, Converter={StaticResource Hue}, ConverterParameter=Tint}"/>
                    <Setter TargetName="Chip" Property="Background" Value="{Binding Hue, Converter={StaticResource Hue}, ConverterParameter=Tint}"/>
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource DurBase}">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="{StaticResource DurFast}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding OpenByIndexCommand}" CommandParameter="8"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCurrentCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="20,24,0,12">
                        <!-- Знак: лаймовая плашка с галочкой («набело, начисто») -->
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center">
                            <ctl:Icon Kind="check" Size="20" StrokeWidth="2.6" Foreground="{DynamicResource OnAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Чистовик" Margin="12,0,0,0" FontFamily="{DynamicResource FontDisplay}"
                                   FontWeight="ExtraBold" FontSize="{DynamicResource FsLg}"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource PlainList}" ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemTemplate="{StaticResource NavTemplate}"
                             ItemContainerStyle="{StaticResource NavItemContainer}"
                             AutomationProperties.Name="Разделы" Margin="0,0,0,12"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource WarnTintBrush}" Padding="24,8"
                        Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Демонстрационные данные">
                    <TextBlock Foreground="{DynamicResource WarnBrush}" FontWeight="Medium" TextWrapping="Wrap"
                               Text="Демонстрационные данные: это не ваш компьютер, изменения никуда не применяются."/>
                </Border>
                <ContentControl x:Name="ContentHost" Grid.Row="1" Content="{Binding Current}"
                                IsTabStop="False" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="HostShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
        </Grid>

        <!-- Строка состояния: агент (слово и значок-форма, не только цвет) и подсказка о горячих клавишах. -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding AgentStatusText, StringFormat=Состояние агента: {0}}"
                            AutomationProperties.LiveSetting="Polite">
                    <ctl:Icon Kind="{Binding AgentStatusIcon}" Size="16" Margin="0,1,8,0" VerticalAlignment="Center">
                        <ctl:Icon.Style>
                            <Style TargetType="ctl:Icon">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AgentStatusKind}" Value="ok">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AgentStatusKind}" Value="warn">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctl:Icon.Style>
                    </ctl:Icon>
                    <TextBlock Text="{Binding AgentStatusText}" Foreground="{DynamicResource TextBrush}"
                               FontSize="{DynamicResource FsSm}" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding AgentStatusDetail}" Style="{StaticResource Subtle}"
                           FontSize="{DynamicResource FsSm}" Margin="14,0,14,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           ToolTip="{Binding AgentStatusDetail}"/>
                <ToggleButton x:Name="KeysButton" Grid.Column="2" Style="{StaticResource KeysToggle}"
                              AutomationProperties.Name="Горячие клавиши">
                    <StackPanel Orientation="Horizontal">
                        <ctl:Icon Kind="keyboard" Size="16" Margin="0,1,8,0" VerticalAlignment="Center"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        <TextBlock Text="Клавиши" FontSize="{DynamicResource FsSm}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=KeysButton}" Placement="Top"
                       HorizontalOffset="0" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=KeysButton, Mode=TwoWay}">
                    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="18,14"
                            AutomationProperties.Name="Горячие клавиши">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Ctrl+1 … Ctrl+8" Style="{StaticResource MonoText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,6"/>
                            <TextBlock Grid.Column="1" Text="разделы по порядку в меню" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Text="F5" Style="{StaticResource MonoText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="перечитать текущий раздел" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Text="Ctrl+F" Style="{StaticResource MonoText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="перейти к поиску" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Text="Esc" Style="{StaticResource MonoText}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="закрыть окно подтверждения или эту подсказку" Foreground="{DynamicResource TextBrush}"/>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
