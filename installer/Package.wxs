<?xml version="1.0" encoding="utf-8"?>
<!-- Установщик Чистовика (WiX v5). Параметры передаёт tools/build-release.ps1:
     -d Version=x.y.z  -d PublishDir=<папка dotnet publish>  -d LicenseRtf=<License.rtf>  -arch x64|arm64 -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Чистовик" Manufacturer="Egoist" Version="$(Version)"
           UpgradeCode="6C1B7E52-3A94-4D0F-9B8E-5F2A7D41C0E3"
           Language="1049" Scope="perMachine" InstallerVersion="500" Compressed="yes">

    <SummaryInformation Description="Чистовик: удаление программ с остатками и управление системой" />

    <!-- Обновление поверх старой версии; откат на более старую запрещён. -->
    <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия Чистовика."
                  Schedule="afterInstallValidate" AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Нижняя граница .NET 10 (Windows 10 1607) проверяет сам запускаемый exe. Здесь только отсечка совсем старых систем:
         Windows Installer в некоторых контекстах (проверено в Windows Sandbox) сообщает VersionNT = 603 даже на Windows 11,
         поэтому условие «VersionNT >= 1000» блокировало установку на современной системе (код 1603). -->
    <Property Id="WINBUILD">
      <RegistrySearch Id="WinBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WINBUILD &gt;= 17763" Message="Чистовику нужна Windows 10 версии 1809 (сборка 17763) или новее." />

    <?if $(sys.BUILDARCH) = x64?>
    <!-- Windows 10 на ARM64 не умеет эмулировать x64 (эмуляция есть только с Windows 11, сборка 22000). -->
    <Property Id="OSARCH">
      <RegistrySearch Id="OsArchSearch" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                      Name="PROCESSOR_ARCHITECTURE" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR OSARCH &lt;&gt; &quot;ARM64&quot; OR WINBUILD &gt;= 22000"
            Message="Эта сборка для процессоров x64 и не работает на Windows 10 для ARM64. Скачайте сборку arm64 или установите Windows 11." />
    <?endif?>

    <Property Id="ARPCOMMENTS" Value="Лицензия GPL-3.0. Данные пользователя в %ProgramData%\Chistovik при удалении сохраняются." />

    <!-- Закрыть работающий App при обновлении и удалении (WM_CLOSE, без принудительного завершения).
         Agent не трогаем: он сам завершается при простое, а убийство посреди операции недопустимо.
         Если Agent ещё работает, Windows Installer предложит закрыть его штатно (FilesInUse) или
         заменит файл после перезагрузки. -->
    <util:CloseApplication Id="CloseChistovikApp" Target="Chistovik.App.exe"
                           CloseMessage="yes" RebootPrompt="no" ElevatedCloseMessage="yes" />

    <!-- Каталог фиксирован (Program Files): Agent проверяет образ по SHA-256 и пути, запись туда
         обычному пользователю закрыта. Выбор каталога в мастере сознательно не даём (WixUI_Minimal). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Chistovik" />
    </StandardDirectory>

    <!-- Все файлы publish-папки, кроме отладочных символов. Подпапки (ресурсы) сохраняются. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Ярлык в меню «Пуск». Ключ компонента — значение в HKLM (установка на весь компьютер). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="Чистовик"
                  Description="Удаление программ с остатками и управление системой"
                  Target="[INSTALLFOLDER]Chistovik.App.exe" WorkingDirectory="INSTALLFOLDER" Icon="ChistovikIcon" />
        <RegistryValue Root="HKLM" Key="Software\Chistovik" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- %ProgramData%\Chistovik (журнал, карантин, настройки) намеренно НЕ описан здесь:
         установщик его не создаёт и не удаляет, данные переживают удаление и переустановку. -->

    <Feature Id="Main" Title="Чистовик" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Значок в «Программы и компоненты» и ярлыке, баннеры мастера в стиле Egoist DS (файлы в installer/assets). -->
    <Icon Id="ChistovikIcon" SourceFile="$(AssetsDir)\chistovik.ico" />
    <Property Id="ARPPRODUCTICON" Value="ChistovikIcon" />
    <WixVariable Id="WixUIBannerBmp" Value="$(AssetsDir)\banner-top-493x58.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(AssetsDir)\dialog-493x312.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
